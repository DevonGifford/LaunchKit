# LaunchKit runs with no environment variables at all — copy this file to
# `.env.local` only when you need to override a default. Never commit secrets:
# every `.env*` file except this one is git-ignored.
#
# Variables are validated at build time by src/env.ts.

# Canonical public origin for metadata, sitemap and hreflang links.
# Default: https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, otherwise
# http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://launchkit.example.com
